    {
     "id": "t4-sam.1",
     "at": "D4 15:00",
     "author": "c_sam",
     "to": [],
     "cc": [],
     "subject": null,
     "body": "idea: Training Grants is way under. can we prepay next year's (FY28) Salesforce renewal now from this year's money?",
     "attachments": [],
     "meta": {}
    },
    {
     "id": "t4-sam.w2",
     "at": "D4 15:20",
     "author": "worker",
     "to": [
      "c_sam"
     ],
     "cc": [],
     "subject": null,
     "body": "No, for two reasons: Training Grants is 08F, which can't pay for agency IT at all; and appropriations pay for goods and services received in the fiscal period, so prepaying FY2028 services with FY2027 money isn't allowed even from the right fund. The FY2028 renewal belongs in next year's budget.",
     "attachments": [],
     "meta": {}
    }
   ]
  },
  {
